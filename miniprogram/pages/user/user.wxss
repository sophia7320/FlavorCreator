/* pages/user/user.wxss */
.page {
  min-height: 100vh;
  background-color: #fff;
  display: flex;
  flex-direction: column;
}

/* 用户头部 */
.user-header {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 60rpx 28rpx 32rpx;
  background: linear-gradient(180deg, rgba(255,225,207,.6) 0%, #fff 100%);
}
.avatar-wrap {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background-color: rgba(255,225,207,1);
  overflow: hidden;
  margin-bottom: 18rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 4rpx solid #fff;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,.08);
}
.avatar {
  width: 100%;
  height: 100%;
}
.avatar.placeholder {
  width: 60%;
  height: 60%;
}
.user-name {
  font-size: 34rpx;
  font-weight: 700;
  color: rgba(87,30,0,1);
}

/* 分区标题 */
.section-title {
  padding: 12rpx 28rpx 18rpx;
  font-size: 28rpx;
  font-weight: 700;
  color: rgba(87,30,0,1);
  border-bottom: 2rpx solid #f5f5f5;
}

/* 菜谱列表 */
.recipe-scroll {
  flex: 1;
  height: 0;
  padding: 16rpx 28rpx;
}
.recipe-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

/* 空状态 */
.empty {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 120rpx 0;
}
.empty-text {
  font-size: 26rpx;
  color: rgba(122,125,132,1);
}

/* 加载状态 */
.list-status {
  text-align: center;
  padding: 28rpx 0;
  font-size: 24rpx;
  color: rgba(122,125,132,1);
}

.bottom-safe {
  height: 60rpx;
}

/* 加载中 */
.loading-wrap {
  height: 100vh;
  display: flex;
  align-items: center;
  justify-content: center;
}
.loading-text {
  font-size: 28rpx;
  color: rgba(122,125,132,1);
}
