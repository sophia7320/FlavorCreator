/* pages/choose-recipes/choose-recipes.wxss */
.choose-recipes-page {
  width: 750rpx;
  min-height: 100vh;
  background-color: rgba(255, 238, 209, 1);
  padding-bottom: 40rpx;
}

/* 顶部导航栏 */
.header {
  width: 100%;
  height: 201rpx;
  background: rgba(255, 225, 207, 1);
  border-radius: 0 0 60rpx 60rpx;
  display: flex;
	gap: 20rpx;
	align-items: center;

  padding: 100rpx 40rpx 0;
}

.header-title {
  font-size: 36rpx;
  color: rgba(87, 30, 0, 1);
}

/* 菜谱列表容器 */
.recipes-container {
  width: 100%;
  padding: 40rpx 40rpx 0;
}

/* 菜谱卡片 */
.recipe-card {
  width: 100%;
	height: 224rpx;
  background-color: rgba(255, 250, 241, 1);
  border-radius: 60rpx;
  padding: 30rpx;
  margin-bottom: 30rpx;
  display: flex;
	gap: 42rpx;
  align-items: center;
  box-shadow: 0 4rpx 20rpx 0 rgba(93, 64, 55, 0.08);
}

.recipe-cover-box {
  width: 155rpx;
  height: 149rpx;
  border-radius: 16rpx;
  background-color: #CCCCCC;
  flex-shrink: 0;
  margin-right: 30rpx;
  display: flex;
  justify-content: center;
  align-items: center;
  overflow: hidden;
}

.recipe-cover {
  width: 100%;
  height: 100%;
  border-radius: 16rpx;
}

.recipe-cover--default {
  width: 22rpx;
  height: 22rpx;
  border-radius: 4rpx;
}

.recipe-info {
  display: flex;
  flex-direction: column;
	gap: 12rpx;
}

.recipe-name {
  font-size: 38rpx;
  font-weight: 700;
  color: rgba(87, 30, 0, 1);
}

.meta-item {
  font-size: 24rpx;
  color: rgba(148, 126, 111, 1);
}

.recipe-actions {
  display: flex;
  align-items: center;
  justify-content: space-between;
	gap: 35rpx;
}

.match-degree {
  width: 167rpx;
	height: 54rpx;
	display: flex;
	justify-content: center;
	align-items: center;
  background-color: rgba(243, 215, 184, 1);
  border-radius: 30rpx;
}

.match-text {
  font-size: 24rpx;
  font-weight: 600;
  color: rgba(154, 92, 37, 1);
}

.start-btn {
	width: 162rpx;
	height: 64rpx;
  padding: 16rpx 32rpx;
  background: rgba(197, 106, 39, 1);
  border-radius: 40rpx;
  box-shadow: 0 4rpx 10rpx 0 rgba(197, 106, 39, 0.7);
}

.start-text {
  font-size: 24rpx;
	display: flex;
	align-items: center;
	justify-content: center;
  font-weight: 600;
  color: #fff;
	
}

/* 空状态 */
.empty-section {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 150rpx 40rpx;
  box-sizing: border-box;
}

.empty-text {
  font-size: 28rpx;
  color: rgba(93, 64, 55, 0.5);
  margin-bottom: 40rpx;
}

.ai-btn {
  padding: 20rpx 60rpx;
  background: linear-gradient(135deg, #D47A48 0%, #C46A3A 100%);
  border-radius: 50rpx;
  box-shadow: 0 4rpx 15rpx 0 rgba(212, 122, 72, 0.3);
}

.ai-btn-text {
  font-size: 28rpx;
  font-weight: 600;
  color: #FFFFFF;
}

/* 加载中 */
.loading-section {
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 200rpx 0;
}

.loading-text {
  font-size: 28rpx;
  color: rgba(93, 64, 55, 0.5);
}
