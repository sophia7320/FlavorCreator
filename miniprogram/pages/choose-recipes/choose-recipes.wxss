/* pages/choose-recipes/choose-recipes.wxss */
.choose-recipes-page {
  width: 750rpx;
  min-height: 100vh;
  background-color: #FFF1E6;
  padding-bottom: 40rpx;
  box-sizing: border-box;
}

/* 顶部导航栏 */
.header {
  width: 100%;
  height: 180rpx;
  background: linear-gradient(180deg, #FFE5D0 0%, #FFD6B8 100%);
  border-radius: 0 0 60rpx 60rpx;
  display: flex;
  align-items: flex-end;
  padding: 0 40rpx 40rpx;
  box-sizing: border-box;
}

.back-btn {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background-color: rgba(255, 255, 255, 0.3);
  display: flex;
  justify-content: center;
  align-items: center;
  margin-right: 20rpx;
}

.back-icon {
  width: 40rpx;
  height: 40rpx;
}

.header-title {
  font-size: 44rpx;
  font-weight: 700;
  color: #5D4037;
  line-height: 56rpx;
}

/* 菜谱列表容器 */
.recipes-container {
  width: 100%;
  padding: 40rpx 40rpx 0;
  box-sizing: border-box;
}

/* 菜谱卡片 */
.recipe-card {
  width: 100%;
  background-color: #FFFFFF;
  border-radius: 60rpx;
  padding: 30rpx;
  box-sizing: border-box;
  margin-bottom: 30rpx;
  display: flex;
  align-items: center;
  box-shadow: 0 4rpx 20rpx 0 rgba(93, 64, 55, 0.08);
}

.recipe-cover {
  width: 200rpx;
  height: 200rpx;
  border-radius: 40rpx;
  background-color: #CCCCCC;
  flex-shrink: 0;
  margin-right: 30rpx;
}

.recipe-info {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.recipe-name {
  font-size: 40rpx;
  font-weight: 700;
  color: #5D4037;
  line-height: 52rpx;
  margin-bottom: 10rpx;
}

.recipe-meta {
  margin-bottom: 20rpx;
}

.meta-item {
  font-size: 24rpx;
  color: rgba(93, 64, 55, 0.6);
  line-height: 32rpx;
}

.recipe-actions {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.match-degree {
  padding: 10rpx 24rpx;
  background-color: #FFD6B8;
  border-radius: 30rpx;
}

.match-text {
  font-size: 24rpx;
  font-weight: 500;
  color: #5D4037;
  line-height: 32rpx;
}

.start-btn {
  padding: 16rpx 32rpx;
  background: linear-gradient(135deg, #D47A48 0%, #C46A3A 100%);
  border-radius: 40rpx;
  box-shadow: 0 4rpx 10rpx 0 rgba(212, 122, 72, 0.3);
}

.start-text {
  font-size: 28rpx;
  font-weight: 600;
  color: #FFFFFF;
  line-height: 36rpx;
}

/* 空状态 */
.empty-section {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 150rpx 40rpx;
  box-sizing: border-box;
}

.empty-text {
  font-size: 28rpx;
  color: rgba(93, 64, 55, 0.5);
  margin-bottom: 40rpx;
}

.ai-btn {
  padding: 20rpx 60rpx;
  background: linear-gradient(135deg, #D47A48 0%, #C46A3A 100%);
  border-radius: 50rpx;
  box-shadow: 0 4rpx 15rpx 0 rgba(212, 122, 72, 0.3);
}

.ai-btn-text {
  font-size: 28rpx;
  font-weight: 600;
  color: #FFFFFF;
}

/* 加载中 */
.loading-section {
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 200rpx 0;
}

.loading-text {
  font-size: 28rpx;
  color: rgba(93, 64, 55, 0.5);
}
