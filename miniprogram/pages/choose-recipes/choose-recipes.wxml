<!--pages/choose-recipes/choose-recipes.wxml-->
<view class="choose-recipes-page">
	<!-- 顶部导航栏 -->
	<view class="header">
		<back-btn></back-btn>
		<view class="header-title">匹配结果</view>
	</view>
	
	<!-- 菜谱列表 -->
	<view class="recipes-container" wx:if="{{!loading && recipes.length > 0}}">
		<view class="recipe-card" wx:for="{{recipes}}" wx:key="id" data-id="{{item.id}}" bindtap="onRecipeTap">
			<view class="recipe-cover-box">
				<image src="{{item.cover || 'https://miniprogram-img-1422554268.cos.ap-guangzhou.myqcloud.com/icon/community/image.svg'}}" mode="aspectFill" class="recipe-cover {{!item.cover ? 'recipe-cover--default' : ''}}"></image>
			</view>
			
			<view class="recipe-info">
				<view class="recipe-name">{{item.name}}</view>
				<view class="recipe-meta">
					<view class="meta-item" wx:if="{{item.cookTime}}">
						<text class="meta-text">烹饪时长：{{item.cookTime}}分钟</text>
					</view>
				</view>
				
				<view class="recipe-actions">
					<view class="match-degree">
						<text class="match-text">匹配度 {{item.matchDegree}}%</text>
					</view>
					<view class="start-btn" catchtap="onStartCook" data-id="{{item.id}}">
						<text class="start-text">开始制作</text>
					</view>
				</view>
			</view>
		</view>
	</view>
	
	<!-- 空状态 -->
	<view class="empty-section" wx:if="{{!loading && recipes.length === 0}}">
		<view class="empty-text">暂无匹配的菜谱</view>
		<view class="ai-btn" wx:if="{{needAiGenerate}}" bindtap="onAiGenerate">
			<text class="ai-btn-text">AI 生成菜谱</text>
		</view>
	</view>
	
	<!-- 加载中 -->
	<view class="loading-section" wx:if="{{loading}}">
		<view class="loading-text">加载中...</view>
	</view>
</view>
