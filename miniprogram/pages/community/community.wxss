/* pages/community/community.wxss */
.community-page {
  width: 750rpx;
  height: 100vh;
  background-color: var(--bg-primary);
	display: flex;
	flex-direction: column;
	align-items: center;
	overflow: hidden;
}

.top-title {
	width: 100%;
	height: 201rpx;
	background-color: rgba(255, 225, 207, 1);
	border-radius: 0 0 60rpx 60rpx;
	padding-top: 120rpx;
	padding-left: 72rpx;
}

.top-title .top-title-text {
	color: rgba(87, 30, 0, 1);
	font-size: 36rpx;
}

.switch-tag {
	height: 40rpx;

	display: flex;
	align-items: center;
	gap: 50rpx;

	font-size: 24rpx;
	font-weight: 350;
	color: rgba(239, 164, 121, 1);

	margin-top: 30rpx;
}

.switch-tag .tag-item.selected {
	font-size: 30rpx;
	color: rgba(185, 89, 33, 1);
}

.divider-line {
	background-color: #BFBFBF;
	
	width: 620rpx;
	height: 1px;
	margin-top: 6rpx;
}

.main {
	width: 100%;
	padding: 0 30rpx;
	flex: 1;
	margin-top: 66rpx;
	/* background-color: #312727; */
}

.main .cards-container {
	display: flex;
	gap: 20rpx;
}

.main .cards-container .left-cards-list, .main .cards-container .right-cards-list {
	width: 336rpx;
	/* background-color: rgb(192, 224, 224); */

	display: flex;
	flex-direction: column;
	gap: 40rpx;
}
.list-status {
	width: 100%;
	text-align: center;
	padding: 40rpx 0;
	font-size: 24rpx;
	color: rgba(122, 125, 132, 1);
}