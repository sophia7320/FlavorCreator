/* pages/community/community.wxss */
.community-page {
  width: 750rpx;
  min-height: 100vh;
  padding: 100rpx 40rpx;
  box-sizing: border-box;
  background-color: var(--bg-primary);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.title {
  font-size: 48rpx;
  font-weight: bold;
  color: var(--color-primary);
  margin-bottom: 30rpx;
}

.empty-text {
  font-size: 28rpx;
  color: var(--text-tertiary);
}
