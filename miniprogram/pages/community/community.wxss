/* pages/community/community.wxss */
.community-page {
  width: 750rpx;
  min-height: 100vh;
  background-color: var(--bg-primary);
  display: flex;
  flex-direction: column;
  align-items: center;
}

.top-title {
  width: 100%;
  height: 201rpx;
  background-color: rgba(255, 225, 207, 1);
  border-radius: 0 0 60rpx 60rpx;
  padding-top: 120rpx;
  padding-left: 72rpx;
  flex-shrink: 0;
}

.top-title .top-title-text {
  color: rgba(87, 30, 0, 1);
  font-size: 36rpx;
}

.switch-tag {
  height: 40rpx;
  display: flex;
  align-items: center;
  gap: 50rpx;
  font-size: 24rpx;
  font-weight: 350;
  color: rgba(239, 164, 121, 1);
  margin-top: 30rpx;
  flex-shrink: 0;
}

.switch-tag .tag-item.selected {
  font-size: 30rpx;
  color: rgba(185, 89, 33, 1);
}

.divider-line {
  background-color: #BFBFBF;
  width: 620rpx;
  height: 1px;
  margin-top: 6rpx;
  flex-shrink: 0;
}

.main {
  width: 100%;
  flex: 1;
  padding: 0 30rpx;
  margin-top: 66rpx;
}

.main .cards-container {
  display: flex;
  gap: 20rpx;
}

.main .cards-container .left-cards-list,
.main .cards-container .right-cards-list {
  width: 336rpx;
  display: flex;
  flex-direction: column;
  gap: 40rpx;
}

.card {
  width: 100%;
  height: 420rpx;
  background-color: rgba(250, 250, 252, 1);
  padding: 18rpx;
  padding-top: 40rpx;
  border-radius: 16rpx;
  flex-shrink: 0;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  border: rgba(255, 225, 207, 1) 1rpx solid;
  box-shadow: 0 4rpx 0 0 rgba(255, 225, 207, 1);
}

.card.first {
  height: 364rpx;
  padding-top: 18rpx;
}

.card .card-header {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.card .card-header .user-image {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background-color: rgba(255, 225, 207, 1);
  display: flex;
  justify-content: center;
  align-items: center;
  overflow: hidden;
}

.card .user-img {
  width: 100%;
  height: 100%;
}

.card .card-header .name-container .user-name {
  font-size: 20rpx;
  font-weight: 700;
  color: rgba(87, 30, 0, 1);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  max-width: 180rpx;
}

.card .card-header .name-container .recipe-name {
  font-size: 14rpx;
  color: rgba(122, 125, 132, 1);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  max-width: 180rpx;
}

.card .card-image-contianer {
  width: 100%;
  height: 192rpx;
  background-color: rgba(205, 206, 207, 1);
  border-radius: 16rpx;
  overflow: hidden;
}

.card .card-image-contianer .card-img {
  width: 100%;
  height: 100%;
}

.card .tool-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.card .tool-bar .like {
  display: flex;
  align-items: center;
  gap: 6rpx;
}

.card .like-btn,
.card .share-btn {
  width: 24rpx;
  height: 24rpx;
}

.card .like-btn.liked {
  opacity: 1;
}

.card .like-count {
  font-size: 18rpx;
  color: rgba(185, 89, 33, 1);
}

/* 底部加载状态 */
.bottom-status {
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 30rpx 0;
  padding-bottom: 50rpx;
}

.loading-tip {
  display: flex;
  align-items: center;
  gap: 12rpx;
  font-size: 22rpx;
  color: #999;
}

.loading-spinner {
  width: 28rpx;
  height: 28rpx;
  border: 3rpx solid #ddd;
  border-top-color: rgba(185, 89, 33, 1);
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

@keyframes spin {
  to {
    transform: rotate(360deg);
  }
}

.no-more-tip {
  font-size: 22rpx;
  color: #bbb;
}

/* 空状态 */
.empty-state {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 20rpx;
}

.empty-icon {
  width: 120rpx;
  height: 120rpx;
  opacity: 0.3;
}

.empty-text {
  font-size: 26rpx;
  color: #aaa;
}
