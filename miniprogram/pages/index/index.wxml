<!--index.wxml-->
<view class="index-page">

	<view class="top-recommand-container">
		<view class="top-title">每日推荐</view>
		<view class="name-date-container">
			<view class="dish-name">{{ dishName }}</view>
			<view class="date-container">
				<view class="week-day" style="font-size: 26rpx; text-align: center;">{{ weekDay }}</view>
				<view class="solar-date">{{ solarDate }}</view>
			</view>
		</view>
		
		<view class="description">{{ description }}</view>
	</view>

	<view class="tool-bar-container">
		<setting-button bind:settingtap="onSettingTap"></setting-button>
		<view class="title">Cooking!</view>
		<view class="ingredients-storage">
			<image src="https://miniprogram-img-1422554268.cos.ap-guangzhou.myqcloud.com/icon/storage-icon.svg" mode="aspectFit" class="ingredients-storage-icon"/>
		</view>
	</view>

	<scroll-view class="main-container" scroll-y="true" enhanced="true" show-scrollbar="false">
		<view class="search-container">
			<view class="listener">
				<image src="https://miniprogram-img-1422554268.cos.ap-guangzhou.myqcloud.com/icon/linstener.png" mode="aspectFit" class="listener-icon"/>
			</view>
			<view class="input-wrapper">
				<view class="input-container">
					<input type="text" class="text-input" placeholder="找不到食材？试试语音手动输入" placeholder-style="color: rgba(191, 191, 191, 1); font-size: 22rpx;" value="{{searchText}}" bindinput="onSearchInput" bindfocus="onInputFocus" bindblur="onInputBlur" />
				</view>
				<!-- 自动补全下拉框 -->
				<view class="autocomplete-dropdown" wx:if="{{showDropdown && autocompleteList.length > 0}}">
					<view class="autocomplete-item" wx:for="{{autocompleteList}}" wx:key="id" bindtap="onSelectAutocomplete" data-item="{{item}}">
						<view class="item-name">{{item.name}}</view>
						<view class="item-unit">{{item.unit}}</view>
					</view>
				</view>
			</view>
			<view class="add-Btn" bindtap="onAddIngredient">
				<image src="https://miniprogram-img-1422554268.cos.ap-guangzhou.myqcloud.com/icon/add.png" mode="aspectFit" class="add-icon"/>
			</view>
		</view>

		<view class="create-process-container">
			<view class="steps-bar">
				<block wx:for="{{ steps }}" wx:key="stepId">
					<view class="item {{currentTab === index ? 'active' : ''}}" id="step-{{index}}" bindtap='onSwitchTab' data-index='{{index}}'>{{ item.name }}</view>
				</block>

				<view class="default-mode">
					<view class="rectangle {{isDefaultMode ? 'active' : ''}}"  bind:tap="onDefaultModeTap">
						<view class="circle" ></view>
					</view>
					<view class="default-mode-text {{isDefaultMode ? 'active' : ''}}">默认模式</view>
				</view>
				<view class="selected-line" style="left: {{ indicatorLeft }}rpx"></view>
			</view>
			<view class="divider-line"></view>
		</view>

		<swiper current='{{ currentTab }}' bindchange="onSlipSwitchTab">
			<swiper-item >
				<!-- 通过自定义组件完成 -->
				<ingredients-choose 
					bind:ingredientsChange="onIngredientsChange"
					selectedIngredientsList="{{selectedIngredients}}"
				></ingredients-choose>
			</swiper-item>


			<!-- 口味 tab -->
			<swiper-item>
				<view class="preferences-container">
					<view class="preferences-grid">
						<view 
							class="preference-item {{item.selected ? 'selected' : ''}}" 
							wx:for="{{tasteOptions}}" 
							wx:key="id"
							data-index="{{index}}"
							bindtap="onSelectTaste"
						>
							<text class="preference-text">{{item.name}}</text>
							<image 
								src="{{item.selected ? 'https://miniprogram-img-1422554268.cos.ap-guangzhou.myqcloud.com/icon/selected-x.svg' : 'https://miniprogram-img-1422554268.cos.ap-guangzhou.myqcloud.com/icon/pink-add.png'}}" 
								mode="aspectFit" 
								class="preference-icon"
							/>
						</view>
					</view>
				</view>
			</swiper-item>

			<!-- 时长 tab -->
			<swiper-item>
				<view class="preferences-container">
					<view class="preferences-list">
						<view 
							class="preference-item {{item.selected ? 'selected' : ''}}" 
							wx:for="{{cookTimeOptions}}" 
							wx:key="id"
							data-index="{{index}}"
							bindtap="onSelectCookTime"
						>
							<text class="preference-text">{{item.name}}</text>
							<image 
								src="{{item.selected ? 'https://miniprogram-img-1422554268.cos.ap-guangzhou.myqcloud.com/icon/selected-x.svg' : 'https://miniprogram-img-1422554268.cos.ap-guangzhou.myqcloud.com/icon/pink-add.png'}}" 
								mode="aspectFit" 
								class="preference-icon"
							/>
						</view>
					</view>
				</view>
			</swiper-item>

			<!-- 份量 tab -->
			<swiper-item>
				<view class="preferences-container">
					<view class="preferences-list">
						<view 
							class="preference-item {{item.selected ? 'selected' : ''}}" 
							wx:for="{{servingsOptions}}" 
							wx:key="id"
							data-index="{{index}}"
							bindtap="onSelectServings"
						>
							<text class="preference-text">{{item.name}}</text>
							<image 
								src="{{item.selected ? 'https://miniprogram-img-1422554268.cos.ap-guangzhou.myqcloud.com/icon/selected-x.svg' : 'https://miniprogram-img-1422554268.cos.ap-guangzhou.myqcloud.com/icon/pink-add.png'}}" 
								mode="aspectFit" 
								class="preference-icon"
							/>
						</view>
					</view>
				</view>
			</swiper-item>
			
		</swiper>

		<view class="basket-wrapper">
			<view class="basket {{showBasketAnimation ? 'animate' : ''}}" bindtap="onBasketTap">
				<image src="https://miniprogram-img-1422554268.cos.ap-guangzhou.myqcloud.com/icon/basket.png" mode="aspectFit" class="basket-icon"/>
			</view>
			<view class="basket-tip" wx:if="{{showBasketTip}}">{{basketTipText}}</view>
		</view>
	</scroll-view>

	<!-- 自定义遮罩层和弹窗 -->
	<view class="basket-modal-wrapper {{showBasketPanel ? 'show' : ''}}">
		<!-- 遮罩层 -->
		<view class="custom-mask" bindtap="onCloseBasketPanel"></view>
		
		<!-- 弹窗内容 -->
		<view class="basket-panel {{showBasketPanel ? 'show' : ''}}">
			<view class="basket-panel-header">
				<view class="basket-panel-title">已选</view>
				<view class="basket-panel-close" bindtap="onCloseBasketPanel">
					<image src="https://miniprogram-img-1422554268.cos.ap-guangzhou.myqcloud.com/icon/down.svg" mode="aspectFit" class="close-icon"/>
				</view>
				<view class="basket-panel-clear" bindtap="onClearSelectedIngredients">
					<image src="https://miniprogram-img-1422554268.cos.ap-guangzhou.myqcloud.com/icon/clear-all.svg" mode="aspectFit" class="clear-icon"/>
					<text class="clear-text">清空</text>
				</view>
			</view>

			<scroll-view class="basket-panel-content" scroll-y="true" show-scrollbar="false">
				<view class="basket-ingredient-list">
					<view class="basket-ingredient-item" wx:for="{{selectedIngredients}}" wx:key="name">
						<view class="ingredient-info">
							<view class="ingredient-name">{{item.name}}</view>
							<view class="ingredient-unit">{{item.unit}}</view>
						</view>
						<view class="ingredient-remove" bindtap="onRemoveIngredient" data-item="{{item}}">
							<image src="https://miniprogram-img-1422554268.cos.ap-guangzhou.myqcloud.com/icon/remove.svg" mode="aspectFit" class="remove-icon"/>
						</view>
					</view>
				</view>
				<view class="basket-empty" wx:if="{{selectedIngredients.length === 0}}">
					<text class="empty-text">暂无选择的食材</text>
				</view>
			</scroll-view>
		</view>
	</view>
	
</view>