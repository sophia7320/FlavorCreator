/**index.wxss**/
.index-page {
	/* ========== 页面专属变量 ========== */
	/* 偏好选项尺寸 */
	--pref-taste-width: 139rpx;
	--pref-taste-height: 69rpx;
	--pref-time-width: 533rpx;
	--pref-time-height: 69rpx;
	--pref-servings-width: 573rpx;
	--pref-servings-height: 69rpx;

	/* 偏好选项字体 */
	--pref-font-size: 24rpx;
	--pref-font-weight: 500;
	--pref-font-color: rgba(93, 64, 55, 1);

	width: 750rpx;
  height: 100vh;

  display: flex;
  flex-direction: column;

	background-color: var(--bg-primary);
	position: relative;
  overflow: hidden;
}

.top-recommand-container {
	width: 750rpx;
	height: 364rpx;

	display: flex;
	flex-direction: column;
	gap: 28rpx;
	padding: 87rpx 53rpx 0 53rpx;
	border-radius: 0 0 80rpx 80rpx;
	background-image: url(https://miniprogram-img-1422554268.cos.ap-guangzhou.myqcloud.com/bg/top-bar-dish-bg.png);

	background-size: 100% 100%;
	position: relative;
	z-index: 10;
}

.top-recommand-container .name-date-container {
	width: 100%;
	margin-top: 10rpx;

	display: flex;
	justify-content: space-between;
}

.top-recommand-container .name-date-container .dish-name {
	font-size: 54rpx;
	
}

.top-recommand-container .name-date-container {
	font-size: 24rpx;
}

.top-recommand-container .description {
	width: 592rpx;
	font-size: 22rpx;
}

.tool-bar-container {
	width: 750rpx;
	height: 80rpx;

	display: flex;
	align-items: center;

	padding: 0 42rpx 0;
	margin-top: 30rpx;
	position: relative;
	z-index: 10;
}

.tool-bar-container .ingredients-storage {
	display: flex;
	justify-content: center;
	align-items: center;

	width: 80rpx;
	height: 80rpx;
	background-color: var(--bg-light-pink);
	border-radius: 50%;

	box-shadow: 0 4rpx 4rpx 0 var(--shadow-black);
}

.tool-bar-container .ingredients-storage .ingredients-storage-icon {
	width: 37rpx;
	height: 38rpx;
}

.tool-bar-container .title {
	flex: 1;
	text-align: center;
	font-size: var(--font-size-5xl);
	font-weight: var(--font-weight-bold);
	color: var(--color-primary);
}

.main-container {
	width: 659rpx;
	height: 947rpx;

	display: flex;
	flex-direction: column;
	position: relative;

	margin: 21rpx auto;
	padding: 50rpx;

	background-color: var(--bg-secondary);
	border-radius: var(--radius-xxxl);
	box-shadow: 0 4rpx 4rpx 0 var(--shadow-black);
}

swiper {
	width: 100%;
	height: 500rpx;
}

.main-container .search-container {
	width: 560rpx;
	height: 77rpx;

	display: flex;
	align-items: center;
	padding: 0 25rpx;

	border-radius: var(--radius-xxxl);
	background-color:  var(--bg-light-pink-alt);
}

.main-container .search-container .listener {
	width: 40rpx;
	height: 40rpx;
}

.main-container .search-container .listener .listener-icon {
	width: 100%;
	height: 100%;
}

.main-container .search-container .input-wrapper {
	flex: 1;
	margin: 0 10rpx;
	position: relative;
	z-index: 100;
}

.main-container .search-container .input-container {
	flex: 1;
	border-radius: var(--radius-small);
	height: 57rpx;
	background-color: var(--bg-white);
	display: flex;
	align-items: center;
	padding-left: 25rpx;
}

/* 自动补全下拉框 */
.autocomplete-dropdown {
	position: absolute;
	top: 67rpx;
	left: 0;
	right: 0;
	background-color: #FFF9F0;
	border-radius: 20rpx;
	box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.15);
	padding: 10rpx 0;
	max-height: 400rpx;
	overflow-y: auto;
	z-index: 1000;
}

.autocomplete-item {
	display: flex;
	justify-content: space-between;
	align-items: center;
	padding: 24rpx 30rpx;
	border-bottom: 1rpx solid rgba(141, 110, 99, 0.1);
	transition: background-color 0.2s ease;
}

.autocomplete-item:last-child {
	border-bottom: none;
}

.autocomplete-item:active {
	background-color: rgba(255, 232, 210, 0.5);
}

.item-name {
	font-size: 30rpx;
	font-weight: 500;
	color: #5D4037;
}

.item-unit {
	font-size: 24rpx;
	color: #8D6E63;
	background-color: rgba(226, 138, 80, 0.15);
	padding: 6rpx 16rpx;
	border-radius: 12rpx;
}

.main-container .search-container .add-Btn {
	width: 43rpx;
	height: 43rpx;

	display: flex;
	justify-content: center;
	align-items: center;

	background-color: var(--bg-secondary);
	border-radius: 50%;
}

.main-container .search-container .add-icon {
	width: 20rpx;
	height: 20rpx;	
}

.main-container .create-process-container {
	width: 570rpx;
	/* height: 50rpx; */
	display: flex;
	flex-direction: column;
	
}

.main-container .create-process-container .steps-bar {
	width: 100%;
	position: relative;

	display: flex;
	gap: 40rpx;
	margin-top: 35rpx;

	font-size: var(--font-size-xl);
	color: var(--color-primary-light);
}

.main-container .create-process-container .default-mode {
	width: 178rpx;
	height: 37rpx;

	display: flex;
	align-items: center;
	gap: 10rpx;
}

.main-container .create-process-container .default-mode .rectangle {
	width: 50rpx;
	height: 28rpx;

	background-color: var(--bg-white-30);
	border: 1rpx solid var(--border-primary);
	border-radius: 900rpx;

	display: flex;
	padding: 0 3.5rpx;
	align-items: center;
}

.main-container .create-process-container .default-mode .rectangle .circle {
	width: 21rpx;
	height: 21rpx;

	border-radius: 50%;
	background-color: var(--func-switch);

	transition: all .2s ease-in-out;
}

.main-container .create-process-container .steps-bar .default-mode .rectangle.active .circle {
	transform: translateX(calc(50rpx - 3.5rpx * 2 - 21rpx)); 
}

.main-container .create-process-container .steps-bar .active {
	color: var(--color-primary);
	font-size: var(--font-size-xl);
}

.main-container .create-process-container .steps-bar .selected-line {
	position: absolute;
	bottom: -12rpx;

	width: 57rpx;
	height: 2rpx;
	border-radius: var(--radius-small);
	background-color: var(--color-primary);
	margin-bottom: 8rpx;
	transition: all .3s ease-in-out;
}


.main-container .create-process-container .divider-line {
	width: 100%;
	height: 2rpx;
	border-radius: var(--radius-small);
	background-color: var(--divider-light);
	margin: 15rpx 0 40rpx 0;
}

.basket-wrapper {
	position: relative;
	/* display: flex;
	flex-direction: column;
	align-items: center; */
}

.basket {
	width: 80rpx;
	height: 80rpx;

	display: flex;
	justify-content: center;
	align-items: center;

	border-radius: 50%;
	background-color: var(--bg-light-pink);

	box-shadow: 0 4rpx 4rpx 0 var(--shadow-black);
}

.basket.animate {
	animation: basketJump 0.4s ease-in-out;
}

@keyframes basketJump {
	0% {
		transform: translateY(0);
	}
	50% {
		transform: translateY(-20rpx);
	}
	100% {
		transform: translateY(0);
	}
}

.basket .basket-icon {
	width: 36rpx;
	height: 36rpx;
}

.basket-tip {
	margin-top: 20rpx;
	font-size: 24rpx;
	color: rgba(49, 39, 36, 0.8);
	text-align: center;
	display: inline-flex;
	width: auto;
	white-space: nowrap;
	border-radius: 10rpx;
	background-color: rgba(237, 186, 186, 0.8);
	padding: 4rpx 12rpx;
}

/* 偏好设置容器 */
.preferences-container {
	width: 100%;
	height: 100%;
	padding-top: 20rpx;
}

/* 口味网格布局 */
.preferences-grid {
	display: grid;
	grid-template-columns: repeat(3, 1fr);
	gap: 20rpx;
}

/* 时长和份量列表布局 */
.preferences-list {
	display: flex;
	flex-direction: column;
	gap: 20rpx;
}

/* 偏好选项 */
.preference-item {
	background-color: var(--bg-light-pink);
	border-radius: 41rpx;
	display: flex;
	justify-content: space-between;
	align-items: center;
	font-size: var(--pref-font-size);
	font-weight: var(--pref-font-weight);
	color: var(--pref-font-color);
	padding: 0 26rpx;
	transition: all 0.2s ease;
}

/* 口味选项：139rpx * 39rpx */
.preferences-grid .preference-item {
	width: var(--pref-taste-width);
	height: var(--pref-taste-height);
}

/* 时长和份量选项：573rpx * 69rpx */
.preferences-list .preference-item {
	width: var(--pref-time-width);
	height: var(--pref-time-height);
}

/* 选中状态 */
.preference-item.selected {
	/* background-color: var(--bg-light-green);
	color: var(--color-primary);
	border: 2rpx solid var(--color-primary); */
	background-color: rgba(232, 167, 167, 1);

	box-shadow: 0 3rpx 3rpx 0 rgba(232, 167, 167, 0.4);
	color: #FFF;
}

.preference-item.selected .preference-icon {
		width: 28rpx;
		height: 28rpx;
}

/* 选项文本 */
.preference-text {
	flex: 1;
}

/* 选项图标 */
.preference-icon {
	width: 20rpx;
	height: 20rpx;
	margin-left: 6rpx;
}

/* ========== 弹窗容器 ========== */
.basket-modal-wrapper {
	position: fixed;
	top: 0;
	left: 0;
	right: 0;
	bottom: 0;
	z-index: 10000;
	opacity: 0;
	pointer-events: none;
	transition: opacity 0.3s ease-out;
}

.basket-modal-wrapper.show {
	opacity: 1;
	pointer-events: auto;
}

/* ========== 自定义遮罩层 ========== */
.custom-mask {
	position: absolute;
	top: 0;
	left: 0;
	right: 0;
	bottom: 0;
	background-color: rgba(0, 0, 0, 0);
	transition: background-color 0.3s ease-out;
}

.basket-modal-wrapper.show .custom-mask {
	background-color: rgba(0, 0, 0, 0.3);
}

/* ========== Basket 面板 ========== */
.basket-panel {
	position: absolute;
	bottom: 0;
	left: 0;
	right: 0;
	background-color: rgba(254, 199, 165, 1);
	border-radius: 80rpx 80rpx 0 0;
	padding: 27rpx 57rpx;
	height: 50vh;
	display: flex;
	flex-direction: column;
	/* 居中 */
	transform: translateY(100%);
	transition: transform 0.3s ease-out;
}

.basket-panel.show {
	transform: translateY(0);
}

.basket-panel-header {
	display: flex;
	align-items: center;
	justify-content: space-between;
	margin-bottom: 30rpx;
	position: relative;
}

.basket-panel-title {
	font-size: 30rpx;
	color: #5D4037;
	text-shadow: 0 4rpx 4rpx rgba(0, 0, 0, 0.25);
}

.basket-panel-close {
	width: 60rpx;
	height: 60rpx;
	display: flex;
	align-items: center;
	justify-content: center;
	border-radius: 50%;
	background-color: rgba(253, 239, 237, 1);
	box-shadow: 0 4rpx 4rpx 0 rgba(0, 0, 0, 0.25);
	position: absolute;
	left: 50%;
	transform: translateX(-50%);
	z-index: 10;
}

.basket-panel-close .close-icon {
	width: 24rpx;
	height: 24rpx;
}

.basket-panel-clear {
	width: 115rpx;
	height: 57rpx;
	display: flex;
	align-items: center;
	gap: 8rpx;
	padding: 12rpx 18rpx;
	border-radius: 50rpx;
	background-color: rgba(253, 239, 237, 1);
	box-shadow: 0 4rpx 4rpx 0 rgba(0, 0, 0, 0.25);
}

.basket-panel-clear .clear-icon {
	width: 28rpx;
	height: 28rpx;
}

.basket-panel-clear .clear-text {
	font-size: 20rpx;
	color: #000;
}

.basket-panel-content {
	flex: 1;
	overflow-y: auto;
}

.basket-ingredient-list {
	display: flex;
	flex-direction: column;
	gap: 20rpx;
}

.basket-ingredient-item {
	display: flex;
	align-items: center;
	justify-content: space-between;
	background-color: #FFF;
	padding: 24rpx 30rpx;
	border-radius: 20rpx;
	box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.08);
}

.ingredient-info {
	display: flex;
	align-items: center;
	gap: 16rpx;
}

.ingredient-name {
	font-size: 30rpx;
	font-weight: 500;
	color: #5D4037;
}

.ingredient-unit {
	font-size: 24rpx;
	color: #8D6E63;
	background-color: rgba(226, 138, 80, 0.15);
	padding: 6rpx 16rpx;
	border-radius: 12rpx;
}

.ingredient-remove {
	width: 56rpx;
	height: 56rpx;
	display: flex;
	align-items: center;
	justify-content: center;
	border-radius: 50%;
	background-color: #FFE8D2;
}

.ingredient-remove .remove-icon {
	width: 14rpx;
	height: 14rpx;
}

.basket-empty {
	display: flex;
	align-items: center;
	justify-content: center;
	padding: 100rpx 0;
}

.basket-empty .empty-text {
	font-size: 28rpx;
	color: #8D6E63;
}
