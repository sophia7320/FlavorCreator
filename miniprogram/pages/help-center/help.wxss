/* pages/help-center/help.wxss */
.help-page {
	width: 750rpx;
	height: 100vh;
	background-color: rgba(255, 238, 209, 1);
	padding-top: 200rpx;
}

/* gap不生效，该死的scroll-view组件，对flex和grid的支持一般 */
.main {
	width: 750rpx;
	height: 1303rpx;
	padding: 0 45rpx;
	display: flex;
	flex-direction: column;
	margin-top: 50rpx;
}

.main .card-container {
	width: 100%;
	height: 384rpx;
	padding: 30rpx;
	background-color: rgba(255, 225, 207, 1);
	border-radius: 40rpx;
	display: flex;
	flex-direction: column;
	gap: 22rpx;
	margin-bottom: 30rpx;
}

.main .card-container .question-container, .main .card-container .answer-container {
	background-color: rgba(255, 250, 241, 1);
	width: 100%;
	border-radius: 30rpx;
	display: flex;
	padding-left: 33rpx;
	color: rgba(87, 30, 0, 1);
}

.main .card-container .question-container {
	align-items: center;
	height: 62rpx;
}

.main .card-container .answer-container {
	padding: 17rpx 33rpx 0;
	height: 240rpx;
}

.answer-content, .question-content {
	white-space: pre-wrap;
	word-break: break-word; /* 长单词折行 */
	color: #000;
	font-size: 24rpx;
}