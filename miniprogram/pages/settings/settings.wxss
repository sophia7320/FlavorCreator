/* pages/settings/settings.wxss */
.settings-page {
  width: 750rpx;
  min-height: 100vh;
  background: linear-gradient(180deg, #FFE8D2 0%, #FFE5BE 100%);
  position: relative;
}

/* 顶部遮罩 */
.top-mask {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 300rpx;
  background: rgba(255, 225, 207, 1);
  border-bottom-left-radius: 60rpx;
  border-bottom-right-radius: 60rpx;
  z-index: 1;
}

/* 顶部导航栏 */
.nav-bar {
  width: 750rpx;
  height: 180rpx;
  padding-top: 80rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-left: 40rpx;
  padding-right: 40rpx;
  box-sizing: border-box;
  position: relative;
  z-index: 10;
}

.back-btn {
  width: 80rpx;
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(255, 255, 255, 0.8);
  border-radius: 50%;
}

.back-icon {
  width: 40rpx;
  height: 40rpx;
}

.nav-title {
  font-size: 40rpx;
  font-weight: 600;
  color: #5D4037;
}

.nav-placeholder {
  width: 80rpx;
}

/* 内容区域 */
.content {
  width: 750rpx;
  padding: 40rpx 50rpx 120rpx;
  box-sizing: border-box;
}

/* 设置选项网格 */
.settings-grid {
  width: 100%;
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 30rpx;
  margin-bottom: 60rpx;
}

.setting-item {
  width: 100%;
}

.item-card {
  width: 100%;
  background: #FFF9F0;
  border-radius: 40rpx;
  padding: 60rpx 40rpx 50rpx;
  box-sizing: border-box;
  box-shadow: 0 6rpx 20rpx rgba(0, 0, 0, 0.06);
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  transition: all 0.3s ease;
}

.item-card:active {
  transform: scale(0.98);
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.08);
}

.item-icon {
  width: 100rpx;
  height: 100rpx;
  margin-bottom: 30rpx;
}

.item-icon-placeholder {
  width: 100rpx;
  height: 100rpx;
  margin-bottom: 30rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.icon-circle {
  width: 80rpx;
  height: 80rpx;
  background: linear-gradient(135deg, #D87C49 0%, #C06C3B 100%);
  border-radius: 50%;
}

.item-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #3E2723;
  margin-bottom: 12rpx;
}

.item-desc {
  font-size: 24rpx;
  color: #8D6E63;
  line-height: 1.4;
}

/* 底部按钮区域 */
.bottom-buttons {
  width: 100%;
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.switch-btn {
  width: 100%;
  height: 100rpx;
  background: linear-gradient(135deg, #E28A50 0%, #D07A40 100%);
  border-radius: 50rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  box-shadow: 0 8rpx 24rpx rgba(210, 122, 64, 0.3);
}

.logout-btn {
  width: 100%;
  height: 100rpx;
  background: linear-gradient(135deg, #FF6B5A 0%, #F85A4A 100%);
  border-radius: 50rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  box-shadow: 0 8rpx 24rpx rgba(248, 90, 74, 0.3);
}

.btn-icon {
  width: 36rpx;
  height: 36rpx;
}

.btn-text {
  font-size: 30rpx;
  font-weight: 600;
  color: #FFFFFF;
}
