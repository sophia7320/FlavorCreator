/* pages/fistLogin/firstLogin.wxss */
.first-login-page {
	--name-font-size: 50rpx;
	--name-font-weight: 700;
	--name-font-color: rgba(64, 32, 10, 1);

	--phone-btn-bg-color: rgba(201, 128, 79, 0.83);
	--wx-btn-bg-color: rgba(2, 216, 107, 0.83);
	--btn-color: #fff;
	--btn-text-font-size: 20rpx;

	--radius: 24rpx;
}

.first-login-page {
	width: 750rpx;
	height: 100vh;

	background-image: url(https://miniprogram-img-1422554268.cos.ap-guangzhou.myqcloud.com/bg.png);
	background-size: 100% 100%;

	display: flex;
	flex-direction: column;
	justify-content: center;
	align-items: center;
}

.title-container {
	display: flex;

}

.title-container .icon {
	width: 156rpx;
	height: 150rpx;
}

.title-container .Name {
	margin: 81rpx 0 0 40rpx;
	font-size: var(--name-font-size);
	font-weight: var(--name-font-weight);
	color: var(--name-font-color);
}

.login-way {
	width: 488rpx;
	height: 158rpx;

	display: flex;
	flex-direction: column;
	justify-content: space-between;
	align-items: center;

	margin-top: 91rpx;
}

.phone-login, .wx-login {
	width: 100%;
	height: 64rpx;

	display: flex;
	justify-content: center;
	align-items: center;

	border-radius: var(--radius);
	color: var(--btn-color);
	font-size: var(--btn-text-font-size);
}

.phone-login {
	background-color: var(--phone-btn-bg-color);

}

.wx-login {
	background-color: var(--wx-btn-bg-color);

} 

.login-way .phone-icon {
	width: 18rpx;
	height: 24rpx;

}

.login-way .wx-icon {
	width: 27rpx;
	height: 23rpx;

}

.login-form-container checkbox-group label {
	width: 400rpx;
	margin-left: 33rpx;
	display: flex;
	margin-top: 12rpx;
}

.login-form-container checkbox-group label.shake {
	animation: agreement-shake .4s ease;
}

.login-form-container checkbox-group .checkbox {
	display: flex;
	align-items: center;
	transform: scale(0.545);
	transform-origin: left bottom;
}

.login-form-container checkbox-group .description {
	color: var(--text-scondary-color);
	font-size: 18rpx;
	font-weight: 400;
}

.login-form-container checkbox-group .description .user-agreement, .login-form-container checkbox-group .description .privacy-agreement {
	color: var(--protocol-color);
}