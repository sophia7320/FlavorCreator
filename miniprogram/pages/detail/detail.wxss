/* pages/detail/detail.wxss */
.page {
  min-height: 100vh;
  background-color: #fff;
}

/* 封面 */
.cover-section {
  width: 100%;
  height: 480rpx;
  position: relative;
  background-color: #f5f5f5;
}
.cover-img {
  width: 100%;
  height: 100%;
}
.cover-overlay {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  padding: 60rpx 24rpx 0;
}
.back-btn {
  width: 64rpx;
  height: 64rpx;
  background: rgba(0,0,0,.35);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}
.back-icon {
  color: #fff;
  font-size: 44rpx;
  font-weight: 300;
  line-height: 1;
}

/* 基本信息 */
.info-section {
  padding: 28rpx 28rpx 20rpx;
}
.recipe-name {
  font-size: 40rpx;
  font-weight: 700;
  color: rgba(87,30,0,1);
  margin-bottom: 18rpx;
}

.author-row {
  display: flex;
  align-items: center;
  gap: 14rpx;
  margin-bottom: 22rpx;
}
.author-avatar-wrap {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background-color: rgba(255,225,207,1);
  overflow: hidden;
  display: flex;
  align-items: center;
  justify-content: center;
}
.author-avatar {
  width: 100%;
  height: 100%;
}
.author-name {
  font-size: 24rpx;
  color: rgba(87,30,0,.7);
}

/* 统计数据 */
.stats-row {
  display: flex;
  gap: 48rpx;
  margin-bottom: 20rpx;
}
.stat-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4rpx;
}
.stat-num {
  font-size: 28rpx;
  font-weight: 700;
  color: rgba(87,30,0,1);
}
.stat-label {
  font-size: 20rpx;
  color: rgba(122,125,132,1);
}

/* 标签 */
.tags-row {
  display: flex;
  gap: 12rpx;
  margin-bottom: 18rpx;
}
.tag {
  padding: 6rpx 18rpx;
  font-size: 20rpx;
  color: #e88d4a;
  background: rgba(255,225,207,.5);
  border-radius: 20rpx;
}

/* 烹饪信息 */
.meta-row {
  display: flex;
  gap: 32rpx;
}
.meta-item {
  display: flex;
  align-items: center;
  gap: 8rpx;
}
.meta-icon {
  font-size: 24rpx;
}
.meta-text {
  font-size: 22rpx;
  color: rgba(122,125,132,1);
}

/* 分隔线 */
.divider {
  height: 16rpx;
  background-color: #f7f7f8;
}

/* 通用 section */
.section {
  padding: 28rpx;
}
.section-title {
  font-size: 30rpx;
  font-weight: 700;
  color: rgba(87,30,0,1);
  margin-bottom: 20rpx;
}

/* 食材 */
.ingredients-list {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}
.ingredient-item {
  display: flex;
  align-items: center;
  gap: 10rpx;
  padding: 10rpx 22rpx;
  background: #fafafc;
  border-radius: 12rpx;
  border: 1rpx solid rgba(255,225,207,1);
}
.ing-name {
  font-size: 24rpx;
  color: rgba(87,30,0,1);
  font-weight: 600;
}
.ing-qty {
  font-size: 22rpx;
  color: rgba(122,125,132,1);
}

/* 步骤 */
.steps-list {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}
.step-item {
  display: flex;
  gap: 16rpx;
}
.step-num {
  width: 40rpx;
  height: 40rpx;
  flex-shrink: 0;
  border-radius: 50%;
  background: rgba(255,225,207,1);
  color: rgba(87,30,0,1);
  font-size: 22rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
}
.step-desc {
  flex: 1;
  font-size: 26rpx;
  color: rgba(87,30,0,.85);
  line-height: 1.7;
  padding-top: 6rpx;
}

/* 小贴士 */
.tips-box {
  padding: 22rpx;
  background: #fff8f0;
  border-radius: 12rpx;
  border-left: 6rpx solid #e88d4a;
}
.tips-text {
  font-size: 24rpx;
  color: rgba(87,30,0,.75);
  line-height: 1.7;
}

/* 加载中 */
.loading-wrap {
  height: 100vh;
  display: flex;
  align-items: center;
  justify-content: center;
}
.loading-text {
  font-size: 28rpx;
  color: rgba(122,125,132,1);
}

/* 底部占位 */
.bottom-placeholder {
  height: 120rpx;
}

/* 底部操作栏 */
.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  height: 100rpx;
  background: #fff;
  border-top: 1rpx solid #eee;
  display: flex;
  align-items: center;
  justify-content: space-around;
  padding-bottom: env(safe-area-inset-bottom);
  z-index: 100;
}
.bar-btn {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 4rpx;
  padding: 0;
  margin: 0;
  border: none;
  background: transparent;
  line-height: normal;
  font-size: inherit;
}
.bar-btn::after {
  border: none;
}
.bar-icon {
  font-size: 36rpx;
}
.bar-label {
  font-size: 20rpx;
  color: rgba(122,125,132,1);
}
.bar-btn.active .bar-label {
  color: #e88d4a;
}
