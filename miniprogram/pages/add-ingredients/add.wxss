/* pages/add-ingredients/add.wxss */
.add-ingredient-page {
	width: 750rpx;
	height: 100vh;
	background-color: var(--bg-primary);
	padding: 201rpx 39rpx 0;
}

.main {
	width: 100%;
	display: flex;
	flex-direction: column;
	align-items: center;
	border-radius: 16rpx;
	background-color: rgba(255, 250, 241, 1);
	margin-top: 50rpx;
	padding: 60rpx 30rpx 20rpx;
	gap: 38rpx;
}

.ingredient-name, .ingredient-amount, .ingredient-unit, .reminder-time ,.entry-time {
	display: flex;
	align-items: center;
	gap: 12rpx;
	height: 60rpx;
	width: 100%;
	border-bottom: 1rpx solid #000;
	font-size: 24rpx;
	font-weight: 700;
}

.down-arrow image {
	width: 28rpx;
	height: 28rpx;
	margin-right: 10rpx;
}

.name, .amount {
  flex: 1;
  height: 100%;
  line-height: 70rpx;
  font-size: 22rpx;
}


.entry-time-value {
	display: flex;
	width: 154rpx;
	height: 47rpx;
	background-color: rgba(255, 225, 207, 1);
	justify-content: center;
	align-items: center;
	border-radius: 12rpx;
	font-size: 20rpx;
	margin-left: auto;
	box-shadow: 2rpx 2rpx 4rpx 0 rgba(0, 0, 0, 0.25);
}

.category-container {
	width: 100%;
	display: flex;
	align-items: start;
	gap: 50rpx;
	margin-top: 20rpx;
}

.category-container .left {
	display: flex;
	align-items: center;
	gap: 12rpx;
	font-size: 24rpx;
	color: rgba(24, 25, 31, 1);
	font-weight: 700;
}

.category-container .content {
	display: grid;
	grid-template-columns: repeat(3, 1fr);
	row-gap: 11rpx;
	column-gap: 40rpx;
}

.category-container .content .item {
	width: 97rpx;
	height: 41rpx;
	background-color: rgba(255, 255, 255, 1);
	border-radius: 12rpx;
	display: flex;
	justify-content: center;
	align-items: center;
	border: 2rpx solid rgba(24, 25, 31, 1);
	font-size: 20rpx;
	font-weight: 600;
}

.point-decoration {
	width: 24rpx;
	height: 24rpx;
	border: 2rpx solid rgba(24, 25, 31, 1);
	border-radius: 50%;
}

.point-decoration.yellow {
	background-color: rgba(255, 189, 18, 1);
}

.unit-picker {
	flex: 1;
	height: 60rpx;
}

.unit-picker-value {
	flex: 1;
	height: 60rpx;
	line-height: 60rpx;
	font-size: 24rpx;
	font-weight: 400;
	color: rgba(24, 25, 31, 1);
	padding-left: 4rpx;
}

.reminder-picker {
	flex: 1;
	height: 60rpx;
}

.reminder-picker-value {
	flex: 1;
	height: 60rpx;
	line-height: 60rpx;
	font-size: 24rpx;
	font-weight: 400;
	color: rgba(24, 25, 31, 1);
	padding-left: 4rpx;
}

.point-decoration.red {
	background-color: rgba(255, 150, 146, 1);
}

.point-decoration.green {
	background-color: rgba(97, 228, 197, 1);
}

.category-container .content .item.active {
	background-color: rgba(255, 225, 207, 1);
	border-color: rgba(255, 150, 146, 1);
}

.picker-row {
	display: flex;
	align-items: center;
	height: 60rpx;
	width: 100%;
}

.confirm-btn {
	width: 127rpx;
	height: 54rpx;
	color: rgba(87, 30, 0, 1);
	font-size: 24rpx;
	font-weight: 700;
	margin-left: auto;
	background-color: rgba(255, 225, 207, 1);
	display: flex;
	justify-content: center;
	align-items: center;
	border-radius: 12rpx;
	box-shadow: 2rpx 2rpx 4rpx rgba(0, 0, 0, 0.25);
}