<!--pages/add-ingredients/add.wxml-->
<view class="add-ingredient-page">
	<top-bar title="{{pageTitle}}"></top-bar>

	<view class="main">
		<view class="ingredient-name">
			<view class="point-decoration yellow"></view>
			<view class="name-title">名称：</view>
			<input type="text" class="name" value="{{name}}" bindinput="bindNameInput" placeholder="例如 鸡蛋" placeholder-style="color: rgba(191, 191, 191, 1); font-size: 24rpx; font-weight: 400;"/>
		</view>

		<view class="ingredient-amount">
			<view class="point-decoration green"></view>
			<view class="name-title">用量：</view>
			<input type="digit" class="amount" value="{{quantity}}" bindinput="bindQuantityInput" placeholder="例如 10" placeholder-style="color: rgba(191, 191, 191, 1); font-size: 24rpx; font-weight: 400;"/>
		</view>

		<view class="ingredient-unit">
			<view class="point-decoration red"></view>
			<view class="name-title">单位：</view>
			<picker class="unit-picker" mode="selector" range="{{units}}" value="{{selectedUnitIndex}}" bindchange="bindUnitChange">
				<view class="unit-picker-value">{{selectedUnit}}</view>
			</picker>
			<view class="down-arrow"><image src="https://miniprogram-img-1422554268.cos.ap-guangzhou.myqcloud.com/icon/down.svg" mode="aspectFit"/></view>
		</view>

		<view class="reminder-time">
			<view class="point-decoration yellow"></view>
			<view class="name-title">提醒时间：</view>
			<picker class="reminder-picker" mode="date" value="{{reminderDate}}" bindchange="bindReminderChange">
				<view class="reminder-picker-value">{{reminderDate}}</view>
			</picker>
			<view class="down-arrow"><image src="https://miniprogram-img-1422554268.cos.ap-guangzhou.myqcloud.com/icon/down.svg" mode="aspectFit"/></view>
		</view>

		<view class="entry-time">
			<view class="point-decoration green"></view>
			<view class="name-title">录入时间：</view>
			<view class="entry-time-value">{{entryTime}}</view>
			<view class="divider-line"></view>
		</view>

		<view class="category-container">
			<view class="left">
				<view class="point-decoration red"></view>
				<view class="name-title">分类：</view>
			</view>
			<view class="content">
				<block wx:for="{{categories}}" wx:key="*this">
					<view class="item {{selectedCategoryIndex === index ? 'active' : ''}}" data-index="{{index}}" bindtap="bindCategoryTap">{{item}}</view>
				</block>
			</view>
		</view>

		<view class="confirm-btn" bindtap="bindConfirm">确定</view>
	</view>

</view>
