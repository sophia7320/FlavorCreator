<!--pages/mine/mine.wxml-->
<view class="mine-page">
	<view class="top-background-img-container">
		<image src="" mode="aspectFill" class="bg-img"/>
	</view>

	<view class="mask"></view>

	<view class="user-info-container">
		<view class="user-avatar-container">
			<image src="{{userInfo.avatarUrl}}" mode="aspectFit" class="user-avatar-img"/>
		</view>
		<view class="user-name">{{userInfo.nickName}}</view>
	</view>

	<view class="main">
		<view class="switch-tags">
			<view class="tag-item {{tagIndex === 0 ? 'active' : ''}}" bindtap="onSwitchTag" data-index="0">
				<text>已发布</text>
			</view>
			<view class="tag-item {{tagIndex === 1 ? 'active' : ''}}" bindtap="onSwitchTag" data-index="1">
				<text>收藏</text>
			</view>
		</view>

		<view class="divider-line"></view>

		<scroll-view class="cards-container" scroll-y>
			<block wx:for="{{currentCards}}" wx:key="id">
				<view class="card-wrapper">
					<recipe-card
						cardData="{{item}}"
						isLiked="{{tagIndex === 1}}"
						bind:liketap="onLike"
						bind:sharetap="onShare"
					/>
				</view>
			</block>
			<view wx:if="{{currentCards.length === 0}}" class="empty-tip">
				暂无内容
			</view>
		</scroll-view>
	</view>
</view>
