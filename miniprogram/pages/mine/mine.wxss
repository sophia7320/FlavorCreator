/* pages/mine/mine.wxss */
.mine-page {
  width: 750rpx;
  min-height: 100vh;
  background: linear-gradient(180deg, #FFE8D2 0%, #FFE5BE 100%);
  padding: 40rpx 50rpx 120rpx;
  box-sizing: border-box;
  position: relative;
}

/* 顶部遮罩 */
.top-mask {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 300rpx;
  background: rgba(255, 225, 207, 1);
  border-bottom-left-radius: 60rpx;
  border-bottom-right-radius: 60rpx;
  z-index: 1;
}

/* 用户信息卡片 */
.user-card {
  width: 100%;
  background: #FFF9F0;
  border-radius: 32rpx;
  padding: 40rpx;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  gap: 24rpx;
  margin-bottom: 40rpx;
  box-shadow: 0 6rpx 20rpx rgba(0, 0, 0, 0.06);
  position: relative;
  z-index: 10;
}

.user-avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background: #E0E0E0;
  flex-shrink: 0;
}

.user-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.user-name {
  font-size: 36rpx;
  font-weight: 600;
  color: #3E2723;
}

.user-id {
  font-size: 24rpx;
  color: #8D6E63;
}

.settings-btn {
  width: 80rpx;
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.settings-icon {
  width: 48rpx;
  height: 48rpx;
}

/* 菜单列表 */
.menu-list {
  width: 100%;
  background: #FFF9F0;
  border-radius: 32rpx;
  overflow: hidden;
  margin-bottom: 30rpx;
  box-shadow: 0 6rpx 20rpx rgba(0, 0, 0, 0.06);
}

.menu-item {
  width: 100%;
  padding: 36rpx 40rpx;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: space-between;
  border-bottom: 1rpx solid rgba(141, 110, 99, 0.1);
  transition: background 0.2s ease;
}

.menu-item:last-child {
  border-bottom: none;
}

.menu-item:active {
  background: rgba(255, 232, 210, 0.5);
}

.menu-left {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.menu-icon {
  width: 44rpx;
  height: 44rpx;
  flex-shrink: 0;
}

.menu-title {
  font-size: 30rpx;
  font-weight: 500;
  color: #5D4037;
}

.menu-arrow {
  width: 16rpx;
  height: 16rpx;
  border-top: 3rpx solid #8D6E63;
  border-right: 3rpx solid #8D6E63;
  transform: rotate(45deg);
  flex-shrink: 0;
}
