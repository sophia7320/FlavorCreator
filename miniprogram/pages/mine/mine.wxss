/* pages/mine/mine.wxss */
.mine-page {
  width: 750rpx;
  height: 100vh;
  background: linear-gradient(180deg, #FFE8D2 0%, #FFE5BE 100%);
  padding: 40rpx 50rpx 120rpx;
  box-sizing: border-box;
  position: relative;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

/* 顶部遮罩 */
.top-mask {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 300rpx;
  background: rgba(255, 225, 207, 1);
  border-bottom-left-radius: 60rpx;
  border-bottom-right-radius: 60rpx;
  z-index: 1;
}

/* 用户信息容器 */
.top-background-img-container {
  width: 100%;
  height: 200rpx;
  border-radius: 32rpx;
  overflow: hidden;
  position: relative;
  z-index: 10;
}

.bg-img {
  width: 100%;
  height: 100%;
}

.mask {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 0;
}

.user-info-container {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-top: -60rpx;
  padding: 0 20rpx;
  position: relative;
  z-index: 10;
}

.user-avatar-container {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background: #E0E0E0;
  flex-shrink: 0;
  overflow: hidden;
}

.user-avatar-img {
  width: 100%;
  height: 100%;
}

.user-name {
  font-size: 36rpx;
  font-weight: 600;
  color: #3E2723;
}

/* 内容区域 */
.main {
  flex: 1;
  display: flex;
  flex-direction: column;
  margin-top: 30rpx;
  position: relative;
  z-index: 10;
  overflow: hidden;
}

/* 标签切换 */
.switch-tags {
  display: flex;
  gap: 40rpx;
  padding: 0 10rpx;
}

.tag-item {
  font-size: 28rpx;
  color: rgba(122, 125, 132, 1);
  padding-bottom: 8rpx;
}

.tag-item.active {
  font-size: 32rpx;
  font-weight: 600;
  color: rgba(87, 30, 0, 1);
  border-bottom: 4rpx solid rgba(185, 89, 33, 1);
}

.divider-line {
  background-color: #BFBFBF;
  width: 100%;
  height: 1px;
  margin-top: 0;
}

/* 卡片列表 */
.cards-container {
  flex: 1;
  margin-top: 24rpx;
}

.card-wrapper {
  width: 100%;
  margin-bottom: 24rpx;
}

.empty-tip {
  width: 100%;
  text-align: center;
  padding: 80rpx 0;
  font-size: 28rpx;
  color: rgba(122, 125, 132, 1);
}
