/* pages/mine/mine.wxss */
.mine-page {
  width: 750rpx;
  height: 100vh;
  background: var(--bg-primary);

  position: relative;

  display: flex;
  flex-direction: column;
  overflow: hidden;
}

/* 用户信息容器 */
.top-container {
  width: 100%;
  height: 500rpx;
  
  overflow: hidden;

  position: relative;
}

.bg-img {
  width: 100%;
  height: 100%;
}

.user-info-container {
  display: flex;
  align-items: flex-end;
	gap: 20rpx;
  
	left: 45rpx;
	bottom: 105rpx;
  position: absolute;
  z-index: 10;
}

.user-avatar-container {
  width: 135rpx;
  height: 135rpx;
  border-radius: 30rpx;
  background: #E0E0E0;
  flex-shrink: 0;
  overflow: hidden;
	border: 2rpx solid var(--text-dark-solid);
}

.user-avatar-img {
  width: 100%;
  height: 100%;
}

.user-name {
  font-size: 36rpx;
  font-weight: 700;
  color: #000;
}

/* 内容区域 */
.main {
	background-color: var(--bg-secondary);
  display: flex;
	flex: 1;
  flex-direction: column;
  position: relative;
  overflow: hidden;
	border-radius: 50rpx 50rpx 0 0;
	padding: 34rpx 69rpx;
	z-index: 10;
}

/* 标签切换 */
.switch-tags {
  display: flex;

	width: 327rpx;
	height: 52rpx;

	background-color: #fff;

	position: relative;
	align-items: center;

	font-size: 21rpx;
	font-weight: 700;

	border-radius: 26rpx;
}

.switch-tags .selected-mark {
	position: absolute;
	left: 0;
	width: 163rpx;
	height: 100%;
	background-color: rgba(232, 167, 167, 1);
	border-radius: 26rpx;
	transition: left 0.3s ease;
}

.tag-item {
	width: 163rpx;
	height: 100%;
  font-size: 22rpx;
  color: var(--text-dark-solid);
	z-index: 1;
	display: flex;
	justify-content: center;
	align-items: center;
	transition: color 0.3s ease;
}

.tag-item.active {
  color: rgba(255, 255, 255, 1);
}

.divider-line {
  background-color: #BFBFBF;
  width: 100%;
  height: 1px;
  margin-top: 16rpx;
}

/* 卡片列表 */
.cards-container {
  /* flex: 1 在 scroll-view 上不可靠，改用 JS 计算高度 */
  margin-top: 24rpx;
}

.cards-grid {
  display: grid;
	height: 100%;
  grid-template-columns: 1fr 1fr;
  gap: 20rpx;
}

.card-wrapper {
  width: 100%;
	height: 100%;
}

.empty-tip {
  width: 100%;
  text-align: center;
  padding-top: 30rpx;
  font-size: 28rpx;
  color: var(--text-muted);
}

.mask {
	width: 100%;
	height: 300rpx;
	position: fixed;
	top: 210rpx;
	background-image: linear-gradient(to top, rgba(255, 238, 209, 1), transparent);
	z-index: 5;
}

.setting-button {
	position: fixed;
	top: 180rpx;
	right: 30rpx;
	z-index: 99;
}