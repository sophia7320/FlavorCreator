/* pages/post/post.wxss */
.post-page {
	width: 750rpx;
	height: 100vh;
	background-color: var(--bg-primary);
	padding: 201rpx 41rpx 0;
	overflow: hidden;
	display: flex;
	flex-direction: column;
}

.main {
	width: 100%;
	height: 1296rpx;
	display: flex;
	flex-direction: column;
	align-items: center;
	margin-top: 36rpx;
}

/* ========== 通用卡片容器 ========== */
.header-container,
.ingredients-container,
.procedure-container {
	width: 100%;
	display: flex;
	flex-direction: column;
	align-items: center;
	padding: 35rpx 45rpx 25rpx;
	gap: 20rpx;
	background-color: var(--bg-secondary);
	border-radius: 40rpx;
	box-shadow: 0 4rpx 4rpx 0 rgba(232, 167, 167, 1);
	margin-bottom: 20rpx;
	position: relative;
}

/* ========== 头图区域 ========== */
.img-container {
	width: 100%;
	display: flex;
	justify-content: center;
}

.recipe-cover {
	width: 568rpx;
	height: 268rpx;
	background-color: rgba(233, 233, 233, 1);
	border: 2rpx solid rgba(191, 191, 191, 1);
	border-radius: 16rpx;
}

.recipe-cover-placeholder {
	display: flex;
	flex-direction: column;
	align-items: center;
	justify-content: center;
	gap: 16rpx;
}

.add-description {
	font-size: 24rpx;
	color: rgba(191, 191, 191, 1);
}

/* ========== 标题 & 描述 ========== */
.divider-line {
	width: 100%;
	background-color: rgba(191, 191, 191, 1);
	height: 1rpx;
}

.title-input-container {
	width: 100%;
	padding: 0 10rpx;
}

.title {
	width: 100%;
	font-size: 30rpx;
	font-weight: 600;
}

.description-container {
	width: 100%;
	height: 128rpx;
	padding: 0 10rpx;
}

.input-description {
	width: 100%;
	height: 100%;
}

/* ========== 通用标题 ========== */
.section-title {
	font-size: 36rpx;
	font-weight: 700;
	color: var(--text-gray-dark);
	margin-right: auto;
	width: 100%;
}

/* ========== 用料区域 ========== */
.ingredients-container {
	gap: 16rpx;
	min-height: 160rpx;
}

.ingredients-content {
	width: 100%;
	display: flex;
	align-items: center;
	justify-content: space-between;
	flex-wrap: wrap;
	gap: 16rpx;
}

.ingredients-content .description {
	font-size: 26rpx;
	color: rgba(191, 191, 191, 1);
}

.ingredient-tags {
	display: flex;
	flex-wrap: wrap;
	gap: 12rpx;
	flex: 1;
}

.ingredient-tag {
	display: flex;
	align-items: center;
	gap: 8rpx;
	padding: 10rpx 20rpx;
	background-color: rgba(255, 255, 255, 0.8);
	border-radius: 20rpx;
	border: 1rpx solid rgba(239, 164, 121, 0.4);
}

.ing-tag-name {
	font-size: 26rpx;
	color: rgba(80, 80, 80, 1);
	font-weight: 500;
}

.ing-tag-amount {
	font-size: 24rpx;
	color: rgba(239, 164, 121, 1);
}

/* ========== 加号按钮 ========== */
.add-btn {
	width: 50rpx;
	height: 50rpx;
	border-radius: 50%;
	background-color: var(--bg-light-pink);
	box-shadow: var(--shadow-sm);
	position: relative;
	display: flex;
	align-items: center;
	justify-content: center;
	flex-shrink: 0;
}

.add-btn::before,
.add-btn::after {
	content: '';
	position: absolute;
	background-color: rgba(191, 191, 191, 1);
	border-radius: 2rpx;
}

.add-btn::before {
	width: 20rpx;
	height: 3rpx;
}

.add-btn::after {
	width: 3rpx;
	height: 20rpx;
}

/* ========== 步骤区域 ========== */
.procedure-container {
	height: auto;
	gap: 0;
}

.procedure-step {
	width: 100%;
	display: flex;
	flex-direction: column;
	gap: 24rpx;
	padding-top: 20rpx;
}

.step-header {
	display: flex;
	align-items: center;
	justify-content: space-between;
}

.step-index {
	font-size: 24rpx;
	color: rgba(191, 191, 191, 1);
}

.step-delete-btn {
	font-size: 22rpx;
	color: rgba(239, 164, 121, 1);
	padding: 6rpx 16rpx;
	border: 1rpx solid rgba(239, 164, 121, 0.5);
	border-radius: 12rpx;
}

.add-cover-container {
	width: 568rpx;
	height: 268rpx;
	background-color: rgba(233, 233, 233, 1);
	border-radius: 16rpx;
	display: flex;
	flex-direction: column;
	justify-content: center;
	align-items: center;
	gap: 16rpx;
	border: 2rpx solid rgba(191, 191, 191, 1);
	position: relative;
	overflow: hidden;
}

.step-image {
	width: 100%;
	height: 100%;
}

.step-image-delete {
	position: absolute;
	top: 10rpx;
	right: 10rpx;
	width: 44rpx;
	height: 44rpx;
	border-radius: 50%;
	background-color: rgba(0, 0, 0, 0.45);
	color: #fff;
	font-size: 28rpx;
	display: flex;
	align-items: center;
	justify-content: center;
}

/* ========== 加号图标（复用） ========== */
.add-icon {
	width: 44rpx;
	height: 44rpx;
	position: relative;
}

.add-icon::before,
.add-icon::after {
	content: '';
	position: absolute;
	background-color: rgba(191, 191, 191, 1);
	border-radius: 2rpx;
	top: 50%;
	left: 50%;
	transform: translate(-50%, -50%);
}

.add-icon::before {
	width: 24rpx;
	height: 3rpx;
}

.add-icon::after {
	width: 3rpx;
	height: 24rpx;
}

/* ========== 步骤输入 ========== */
.step-input-container {
	width: 100%;
	padding: 0 4rpx;
}

.more-description {
	width: 100%;
	font-size: 26rpx;
	padding: 12rpx 0;
}

/* ========== 分割虚线 ========== */
.divider-dots-line {
	width: 100%;
	height: 2rpx;
	border-bottom: 2rpx dashed rgba(191, 191, 191, 0.5);
	margin: 8rpx 0;
}

/* ========== 添加步骤按钮 ========== */
.add-procedure-btn {
	width: 159rpx;
	height: 50rpx;
	margin-left: auto;
	margin-right: 0;
	display: flex;
	align-items: center;
	justify-content: center;
	background-color: rgba(239, 164, 121, 1);
	border-radius: 16rpx;
	font-size: 24rpx;
}

/* ========== 分类区域 ========== */
.category-container {
	width: 100%;
	margin-top: 20rpx;
}

.category-container .section-title {
	margin-left: 42rpx;
}

.category-container .description {
	color: rgba(191, 191, 191, 1);
	font-size: 20rpx;
	margin-left: 42rpx;
	margin-top: 10rpx;
}

.category-container .items-container {
	width: 100%;
	display: grid;
	grid-template-columns: repeat(4, 1fr);
	row-gap: 17rpx;
	margin-top: 17rpx;
}

.category-container .items-container .item {
	width: 147rpx;
	height: 53rpx;
	background-color: rgba(255, 255, 255, 1);
	border-radius: 30rpx;
	display: flex;
	justify-content: center;
	align-items: center;
	font-size: 24rpx;
	color: var(--text-gray-dark);
	transition: all 0.2s ease;
}

.category-container .items-container .item-selected {
	background-color: rgba(239, 164, 121, 1);
	color: #fff;
	font-weight: 600;
}

.category-container .divider-line {
	margin-top: 42rpx;
	background-color: var(--text-dark-solid);
}

/* ========== 发布按钮 ========== */
.send-btn {
	width: 167rpx;
	height: 60rpx;
	margin-left: auto;
	background-color: rgba(255, 255, 255, 1);
	border: 2rpx solid #000;
	display: flex;
	justify-content: center;
	align-items: center;
	border-radius: 16rpx;
	margin-top: 28rpx;
	margin-bottom: 40rpx;
	font-weight: 700;
	font-size: 28rpx;
	color: rgba(80, 80, 80, 1);
}

/* ========== 用料编辑弹窗 ========== */
.modal-mask {
	position: fixed;
	top: 0;
	left: 0;
	width: 100vw;
	height: 100vh;
	background-color: rgba(0, 0, 0, 0.45);
	z-index: 999;
	display: flex;
	align-items: center;
	justify-content: center;
}

.modal-container {
	width: 580rpx;
	background-color: #fff;
	border-radius: 24rpx;
	padding: 40rpx 36rpx 30rpx;
	display: flex;
	flex-direction: column;
	gap: 30rpx;
}

.modal-title {
	font-size: 34rpx;
	font-weight: 700;
	color: var(--text-gray-dark);
	text-align: center;
}

.modal-form {
	display: flex;
	flex-direction: column;
	gap: 24rpx;
}

.modal-form-item {
	display: flex;
	align-items: center;
	gap: 16rpx;
}

.modal-label {
	font-size: 28rpx;
	color: var(--text-gray-dark);
	flex-shrink: 0;
	width: 130rpx;
}

.modal-input {
	flex: 1;
	border: 1rpx solid rgba(191, 191, 191, 0.5);
	border-radius: 12rpx;
	padding: 16rpx 20rpx;
	font-size: 28rpx;
}

.modal-actions {
	display: flex;
	justify-content: space-between;
	gap: 24rpx;
	margin-top: 10rpx;
}

.modal-btn {
	flex: 1;
	height: 80rpx;
	border-radius: 16rpx;
	display: flex;
	align-items: center;
	justify-content: center;
	font-size: 30rpx;
	font-weight: 500;
}

.modal-btn-cancel {
	background-color: rgba(233, 233, 233, 1);
	color: var(--text-gray-dark);
}

.modal-btn-confirm {
	background-color: rgba(239, 164, 121, 1);
	color: #fff;
}

/* ========== 单位选择器 ========== */
.picker-unit {
	flex: 1;
	display: flex;
	align-items: center;
	border: 1rpx solid rgba(191, 191, 191, 0.5);
	border-radius: 12rpx;
	padding: 16rpx 20rpx;
	font-size: 28rpx;
}
