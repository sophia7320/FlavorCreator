/* pages/recipe-detail/recipe-detail.wxss */
.recipe-detail-page {
	width: 750rpx;
	height: 100vh;
	background-color: var(--bg-primary);
	padding-top: 201rpx;
}

scroll-view {
	height: calc(100vh - 201rpx - 50rpx);
	display: flex;
	flex-direction: column;
	align-items: center;
}

.head-container {
	width: 100%;
	height: 593rpx;
	margin-top: 95rpx;
	display: flex;
	flex-direction: column;
	gap: 48rpx;
	margin-bottom: 53rpx;
}

.head-container .recipe-cover {
	width: 100%;
	height: 342rpx;
	background-color: var(--bg-secondary);
	border-radius: 28rpx;
}

.head-container .recipe-name, .head-container .desc {
	padding: 0 49rpx;
}

.head-container .recipe-name {
	font-size: 40rpx;
	font-weight: 700;
}

.head-container .desc {
	font-size: 24rpx;
	color: rgba(191, 191, 191, 1);
}

/* 标签 & 基本信息 */
.meta-info {
	padding: 0 49rpx;
	margin-bottom: 36rpx;
	display: flex;
	flex-direction: column;
	gap: 18rpx;
}

.tags-row {
	display: flex;
	flex-wrap: wrap;
	gap: 12rpx;
}

.tag {
	padding: 6rpx 18rpx;
	background-color: var(--bg-secondary);
	border-radius: 16rpx;
	font-size: 20rpx;
	color: var(--text-brand-dark);
}

.info-row {
	display: flex;
	gap: 24rpx;
}

.info-item {
	padding: 6rpx 16rpx;
	border-radius: 16rpx;
	background-color: rgba(245, 245, 245, 1);
}

.info-value {
	font-size: 20rpx;
	color: rgba(150, 150, 150, 1);
}

.ingredients-container, .procedure-container {
	padding: 0 49rpx;
}

.ingredients-container {
	display: flex;
	flex-direction: column;
	gap: 20rpx;
	margin-bottom: 64rpx;
}

.ingredients-container .title, .procedure-container .title{
	font-size: 36rpx;
	font-weight: 700;
}

.divider-dashed-line {
	width: 100%;
	 border-top: 2rpx dashed #000;
}

.ingredients-container .item-list {
	display: flex;
	flex-direction: column;
	gap: 18rpx;
}

.ingredients-container .item-list .item {
	display: flex;
	flex-direction: column;
	gap: 12rpx;
}

.ingredients-container .item-list .item .item-info {
	display: flex;
	justify-content: space-between;
	align-items: center;
}

.ingredients-container .item-list .item .item-info .item-name {
	font-size: 24rpx;
	font-weight: 600;
}

.ingredients-container .item-list .item .item-info .item-quantity {
	width: 100rpx;
	height: 35rpx;
	background-color: var(--bg-secondary);
	display: flex;
	justify-content: center;
	align-items: center;
	border-radius: 12rpx;
	font-size: 20rpx;
}

.divider-item-line {
	width: 100%;
	border-top: 2rpx dashed rgba(191, 191, 191, 1);
}

.procedure-container {
	display: flex;
	flex-direction: column;
	gap: 20rpx;
	margin-bottom: 38rpx;
}

.procedure-container .item-container {
	display: flex;
	flex-direction: column;
	align-items: center;
	gap: 27rpx;
}

.procedure-container .item-head-container {
	display: flex;
	flex-direction: column;
	gap: 14rpx;
}

.procedure-container .item-head-container .step {
	margin-right: auto;
	font-size: 24rpx;
	font-weight: 700;
}

.procedure-container .item-container .step-desc {
	color: rgba(23, 23, 23, 1);
	font-size: 24rpx;
}


.procedure-container .item-head-container .step-cover-wrapper {
	width: 553rpx;
	height: 309rpx;
	background-color: var(--bg-secondary);
	border-radius: 40rpx;
	overflow: hidden;
}

.procedure-container .item-head-container .step-cover {
	width: 100%;
	height: 100%;
}

.divider-line {
	height: 1rpx;
	width: 652rpx;
	background-color: #000;
	margin: 0 auto;
}

.tool-bar {
	width: 574rpx;
	display: flex;
	justify-content: space-between;
	align-items: center;
	margin: 0 auto;
	margin-top: 12rpx;
}

.tool-bar .left-action {
	display: flex;
	align-items: center;
	gap: 65rpx;
}

.tool-bar .collect-btn {
	display: flex;
	align-items: center;
	gap: 8rpx;
}

.tool-bar .collect-btn .collect-icon, .tool-bar .share-btn .share-icon, .finish-btn .finish-icon {
	width: 30rpx;
	height: 27rpx;
}

.collect-count-text {
	font-size: 20rpx;
	color: var(--text-muted);
}

.tool-bar .share-btn {
	padding: 0;
	margin: 0;
	background: transparent;
	border: none;
	line-height: 1;
	display: flex;
	align-items: center;
}

.tool-bar .share-btn::after {
	border: none;
}

.finish-btn {
	display: flex;
	align-items: center;
	width: 239rpx;
	height: 62rpx;
	justify-content: center;
	background-color: var(--bg-secondary);
	color: var(--text-brand-dark);
	gap: 5rpx;
	font-size: 22rpx;
	border-radius: 20rpx;
}