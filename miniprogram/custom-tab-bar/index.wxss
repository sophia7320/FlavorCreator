/* custom-tab-bar/index.wxss */
.tab-bar {
	--radius-xl: 50rpx;
	--bg-white-transparent: rgba(255, 255, 255, 0.7);
	--font-size-xs: 12rpx;
	--color-primary: rgba(186, 91, 33, 1);
	--create-anim-duration: 0.3s;
	--create-anim-easing: ease-in-out;

	width: 750rpx;
	height: 134rpx;

	display: flex;
	align-items: start;
	justify-content: center;
}

.tab-bar .container {
	width: 659rpx;
	height: 94rpx;

	border-radius: var(--radius-xl);
	background-color: var(--bg-white-transparent);

	display: flex;
	align-items: center;
	justify-content: space-between;

	padding: 0 107rpx;
}

.community, .ME {
	display: flex;
	flex-direction: column;
	align-items: center;
}

.description {
	font-size: var(--font-size-xs);
	color: var(--color-primary);
	margin-top: 4rpx;
}

.community-icon, .ME-icon {
	width: 34rpx;
	height: 34rpx;
}

.FC-create {
	position: relative;
	width: 130rpx;
	height: 130rpx;
	overflow: hidden;
	border-radius: 50%;
	transform: translateY(-25rpx);
	background-image: url(https://miniprogram-img-1422554268.cos.ap-guangzhou.myqcloud.com/bg/bar-home-bg.png);
	background-size: 100% 100%;
}

.FC-create-icon {
	width: 130rpx;
	height: 130rpx;
}

/* 终态：图标原位 / 文字在容器外 */
.FC-create-icon.hide {
	transform: translateY(0);
}

.FC-create-icon.show {
	transform: translateY(-130rpx);
}

.create-text {
	position: absolute;
	inset: 0;
	margin: auto;

	width: 130rpx;
	height: 130rpx;
	border-radius: 50%;
	display: flex;
	align-items: center;
	justify-content: center;
	color: rgba(185, 89, 33, 1);
	font-weight: 700;
	font-size: 30rpx;
}

.create-text.hide {
	transform: translateY(130rpx);
}

.create-text.show {
	transform: translateY(0);
}

/* 选中食材 / 取消最后一个：关键帧动画（与原 transition 0.3s ease-in-out 一致） */
@keyframes create-icon-show {
	from {
		transform: translateY(0);
	}
	to {
		transform: translateY(-130rpx);
	}
}

@keyframes create-icon-hide {
	from {
		transform: translateY(-130rpx);
	}
	to {
		transform: translateY(0);
	}
}

@keyframes create-text-show {
	from {
		transform: translateY(130rpx);
	}
	to {
		transform: translateY(0);
	}
}

@keyframes create-text-hide {
	from {
		transform: translateY(0);
	}
	to {
		transform: translateY(130rpx);
	}
}

.FC-create-icon.show.animate {
	animation: create-icon-show var(--create-anim-duration) var(--create-anim-easing) forwards;
}

.FC-create-icon.hide.animate {
	animation: create-icon-hide var(--create-anim-duration) var(--create-anim-easing) forwards;
}

.create-text.show.animate {
	animation: create-text-show var(--create-anim-duration) var(--create-anim-easing) forwards;
}

.create-text.hide.animate {
	animation: create-text-hide var(--create-anim-duration) var(--create-anim-easing) forwards;
}

/* 无动画：瞬间落到终态（Tab 接力首帧等） */
.FC-create-icon.no-transition,
.create-text.no-transition {
	animation: none !important;
}

.FC-create-icon.no-transition.hide {
	transform: translateY(0);
}

.FC-create-icon.no-transition.show {
	transform: translateY(-130rpx);
}

.create-text.no-transition.hide {
	transform: translateY(130rpx);
}

.create-text.no-transition.show {
	transform: translateY(0);
}
