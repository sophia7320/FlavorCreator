/* components/top-bar/top-bar.wxss */
.top-mask {
  height: 201rpx;
  background: rgba(255, 225, 207, 1);
  border-radius: 0 0 60rpx 60rpx;
  z-index: 10;
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
}

.nav-bar {
  width: 100%;
  height: 180rpx;
  display: flex;
  align-items: center;
  padding: 80rpx 0 0 61rpx;
  position: relative;
  z-index: 10;
}

.nav-title {
  margin-left: 20rpx;
  font-size: 36rpx;
  color: rgba(87, 30, 0, 1);
}
