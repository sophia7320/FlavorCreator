/* components/AI-btn/AI-btn.wxss */
.AI-btn {
  width: 80rpx;
  height:80rpx;
	display: flex;
	justify-content: center;
	align-items: center;
	background-color: var(--bg-light-pink);
	border-radius: 50%;
	box-shadow: var(--shadow-sm);
	transition: all 0.3s ease;
	padding: 23rpx;
}

.AI-btn image {
	width: 100%;
	height: 100%;
}

.AI-btn.selected {
  background-color: var(--bg-pink-selected);
}