/* components/recipe-card/recipe-card.wxss */
.card {
  width: 100%;
  height: 420rpx;
  background-color: rgba(250, 250, 252, 1);

  padding: 18rpx;
  padding-top: 40rpx; 
  border-radius: 16rpx;

  /* 防止first的高度设置没有生效 */
  flex-shrink: 0;

  display: flex;
  flex-direction: column;
  justify-content: space-between;

  border: var(--bg-secondary) 1rpx solid;
  box-shadow: 0 4rpx 0 0 var(--bg-secondary);

  position: relative;
}

.card.first {
  width: 100%;
  height: 364rpx;
  padding-top: 18rpx;
  /* background-color: aquamarine; */
}

.card .card-header {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.card .card-header .user-image {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background-color: var(--bg-secondary);

  display: flex;
  justify-content: center;
  align-items: center;
	overflow: hidden;
}

.card .user-img {
  width: 100%;
  height: 100%;
}

.card .card-header .name-container .user-name {
  font-size: 20rpx;
  font-weight: 700;
  color: var(--text-brand-dark);
}

.card .card-header .name-container .publish-date {
  font-size: 14rpx; 
  color: var(--text-muted);
}

.card .card-image-contianer {
  width: 100%;
  height: 192rpx;
  background-color: rgba(205, 206, 207, 1);
  border-radius: 16rpx;
  overflow: hidden;

  display: flex;
  justify-content: center;
  align-items: center;
}

.card .card-image-contianer .card-img {
  width: 100%;
  height: 100%;
}

.recipe-name {
	color: var(--text-brand-dark);
	font-weight: 550;
	font-size: 26rpx;
}

.card .tool-bar {
  display: flex;
  justify-content: space-between;
}

.card .tool-bar .collect {
	display: flex;
	align-items: center;
	gap: 6rpx;
}

.card .collect-btn , .card .share-btn{
	width: 24rpx;
	height: 24rpx;
}

/* 重置 share button 默认样式 */
.card .tool-bar .share {
  padding: 0;
  margin: 0;
  border: none;
  background: transparent;
  line-height: normal;
  display: flex;
  align-items: center;
}
.card .tool-bar .share::after {
  border: none;
}

.card .collect-count {
	font-size: 20rpx;
	color: var(--text-muted);
}

/* 已收藏状态 */
.card .tool-bar .collect.collected .collect-btn {
	transform: scale(1.1);
}
.card .tool-bar .collect.collected .collect-count {
	color: #E74C3C;
}

/* 删除按钮 */
.delete-btn {
	position: absolute;
	top: 14rpx;
	right: 14rpx;
	width: 26rpx;
	height: 26rpx;
	border-radius: 50%;
	background: var(--shadow-black);
	display: flex;
	justify-content: center;
	align-items: center;
	z-index: 2;
}

.delete-icon {
	font-size: 20rpx;
	color: #fff;
	line-height: 1;
}
